# Finviz Elite API credentials
# Required — obtain from your Finviz Elite account at finviz.com/elite
FINVIZ_API_TOKEN=your_finviz_api_token_here

# Finviz screener export URL
# Go to Finviz Elite screener, apply your filters, click Export, copy the URL (without &auth=...)
FINVIZ_EXPORT_URL=https://elite.finviz.com/export.ashx?v=111&f=...

# MongoDB connection (optional — defaults to local MongoDB on port 27017)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=stocktwits_dashboard
